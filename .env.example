# ==============================================================================
# Mashahir Danesh Law School 360-Degree Support Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local to VCS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16 Alpine)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/mashahir_support_db

# ------------------------------------------------------------------------------
# 3. Authentication, JWT & Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
NEXTAUTH_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
SESSION_COOKIE_NAME=mashahir_session

# ------------------------------------------------------------------------------
# 4. Kavenegar SMS Gateway Integration
# ------------------------------------------------------------------------------
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY_HERE
KAVENEGAR_SENDER_NUMBER=10004346

# ------------------------------------------------------------------------------
# 5. Issabel Asterisk AMI (VoIP PBX) Configuration
# ------------------------------------------------------------------------------
ASTERISK_HOST=192.168.1.50
ASTERISK_PORT=5038
ASTERISK_USERNAME=your_ami_username
ASTERISK_SECRET=your_ami_secret_password
ASTERISK_CONTEXT=from-internal
ASTERISK_CHANNEL_TECH=SIP
ASTERISK_TRUNK=SIP/mashahir_trunk
ASTERISK_CALLER_ID=02191000000

# ------------------------------------------------------------------------------
# 6. Webinar & Virtual Classroom Platform
# ------------------------------------------------------------------------------
VIDEO_SERVER_URL=https://room.mashahir.ac.ir
VIDEO_API_KEY=your_video_conferencing_api_key_here

# ------------------------------------------------------------------------------
# 7. OTP Configuration
# ------------------------------------------------------------------------------
OTP_EXPIRY_SECONDS=120
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_RATE_LIMIT_MAX_ATTEMPTS=3

# Set to false in production to enforce real SMS dispatch
ENABLE_MOCK_OTP=true
MOCK_OTP_CODE=12345
